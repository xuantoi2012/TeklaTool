<Window x:Class="TeklaTool_2017.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Phần mềm tạo đơn hàng tự động v2017" 
        MinHeight="800" MinWidth="1250" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Margin="0,0,0,10" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Logo -->
                <Image Source="/Images/tekla_logo.png" 
                       Height="60" Width="100" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" Grid.Column="0" Margin="0,0,10,0"/>
                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Phần mềm tạo đơn hàng tự động v2017" 
                     FontSize="18" FontWeight="Bold" 
                     Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Tự động thống kê vật liệu từ mô hình Tekla Structures" 
                     FontSize="11" 
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nhóm Select -->
                    <Border BorderBrush="#D1D5DB" BorderThickness="0,0,1,0" Margin="0,0,10,0" Padding="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔍 Chọn Parts" 
                                Command="{Binding SelectPartsCommand}" Height="35"
                                Style="{StaticResource ModernButton}" Margin="0,0,20,0"/>
                            <Button Content="📦 Chọn Model" Height="35"
                                Command="{Binding SelectAllModelCommand}"
                                Style="{StaticResource  WarningButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- Nhóm Excel -->
                    <Border BorderBrush="#D1D5DB" BorderThickness="0,0,0,0" Padding="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📊 Xuất Excel" Height="35"
                                Command="{Binding ExportExcelCommand}"
                                Style="{StaticResource SuccessButton}"/>
                            <Button Content="⚙️ Cài đặt" Height="35"
                                Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource InfoButton}"
                                Margin="20,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results Section with TabControl -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" 
                                          Background="Transparent"
                                          BorderThickness="0,0,0,2"
                                          BorderBrush="Transparent"
                                          Padding="12,6"
                                          Margin="0,0,4,0">
                                        <ContentPresenter ContentSource="Header" 
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" 
                                                  Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" 
                                                  Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" 
                                                  Value="#F9FAFB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </TabControl.Resources>

                <!-- Plate Tab -->
                <TabItem Header="🔲 Thép Tấm" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFF6F8FA" CornerRadius="4" 
                Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Chiều rộng tấm (mm):" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="0" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding PlateWidth, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxWithPlaceholder}" Grid.Column="1" Height="35" Tag="Nhập chiều rộng..."/>

                                <TextBlock Text="Chiều dài tấm (mm):" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="3" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding PlateLength, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxWithPlaceholder}" Grid.Column="4" Height="35" Tag="Nhập chiều dài..."/>

                                <TextBlock Text="Vật liệu:" VerticalAlignment="Center" 
                                    FontSize="12" Grid.Column="6" Margin="0,0,8,0"/>
                                <ComboBox SelectedItem="{Binding PlateMaterial, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ModernComboBox}"
                                  Grid.Column="7">
                                    <sys:String>SS400</sys:String>
                                    <sys:String>Q345</sys:String>
                                    <sys:String>Q355</sys:String>
                                </ComboBox>

                                <TextBlock Text="Ghi chú:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="9" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding PlateNote, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxWithPlaceholder}" 
                         Grid.Column="10" Height="35"
                         Tag="Nhập ghi chú..." TextWrapping="Wrap"
                         ToolTip="Ghi chú chung cho thép tấm"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding PlateData}" 
                          Style="{StaticResource ModernDataGrid}"
                          CellEditEnding="OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Dày (mm)" Binding="{Binding ChieuDay}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Rộng (mm)" Binding="{Binding ChieuRong}" Width="0.5*" ElementStyle="{StaticResource DataGridTextBlockStyle}" EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                                <DataGridTextColumn Header="Dài (mm)" Binding="{Binding ChieuDai}" Width="0.5*" ElementStyle="{StaticResource DataGridTextBlockStyle}" EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="KL (kg)" Binding="{Binding KhoiLuong}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>

                                <!-- ComboBox Vật liệu - Editable -->
                                <DataGridTemplateColumn Header="Vật liệu" Width="*" CellStyle="{StaticResource ComboBoxCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VatLieu}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding VatLieu, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DataGridComboBox}">
                                                <sys:String>SS400</sys:String>
                                                <sys:String>Q345</sys:String>
                                                <sys:String>Q355</sys:String>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" ElementStyle="{StaticResource DataGridTextBlockStyle}" EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Shape Tab -->
                <TabItem Header="📏 Thép Hình" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFF6F8FA" CornerRadius="4" 
                Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Chiều dài thép hình (mm):" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="0" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding ShapeLength, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxWithPlaceholder}" Grid.Column="1" Height="35" Tag="Nhập chiều dài..."/>

                                <TextBlock Text="Vật liệu:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="3" Margin="0,0,8,0"/>
                                <ComboBox SelectedItem="{Binding ShapeMaterial, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ModernComboBox}"
                          Grid.Column="4">
                                    <sys:String>SS400</sys:String>
                                    <sys:String>Q345</sys:String>
                                    <sys:String>Q355</sys:String>
                                </ComboBox>

                                <TextBlock Text="Ghi chú:" VerticalAlignment="Center" 
                                    FontSize="12" Grid.Column="6" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding ShapeNote, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxWithPlaceholder}"  
                                     Grid.Column="7" Height="35"
                                     Tag="Nhập ghi chú..."
                                    ToolTip="Ghi chú chung cho thép hình"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ShapeData}" 
                  Style="{StaticResource ModernDataGrid}"
                  CellEditEnding="OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Quy cách" Binding="{Binding QuyCach}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Dài (mm)" Binding="{Binding ChieuDai}" Width="0.5*" ElementStyle="{StaticResource DataGridTextBlockStyle}" EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                                <DataGridTextColumn Header="Tổng dài (mm)" Binding="{Binding TongChieuDai}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="KL/m (kg)" Binding="{Binding KhoiLuongDonVi}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="KL (kg)" Binding="{Binding KhoiLuong}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>

                                <!-- ComboBox Vật liệu - Editable -->
                                <DataGridTemplateColumn Header="Vật liệu" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VatLieu}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding VatLieu, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DataGridComboBox}">
                                                <sys:String>SS400</sys:String>
                                                <sys:String>Q345</sys:String>
                                                <sys:String>Q355</sys:String>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" ElementStyle="{StaticResource DataGridTextBlockStyle}" EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Bolt Tab -->
                <TabItem Header="🔩 Bulong" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFF6F8FA" CornerRadius="4" 
                            Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cường độ bulong:" 
                           VerticalAlignment="Center" 
                           FontSize="12" 
                           Grid.Column="0" 
                           Margin="0,0,8,0"/>
                                <ComboBox SelectedItem="{Binding BoltGrade, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ModernComboBox}"
                          Grid.Column="1">
                                    <sys:String>CB 4.6</sys:String>
                                    <sys:String>CB 5.6</sys:String>
                                    <sys:String>CB 8.8</sys:String>
                                    <sys:String>CB 10.9</sys:String>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding BoltData}" 
                          Style="{StaticResource ModernDataGrid}"
                          CellEditEnding="OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Kích thước" Binding="{Binding KichThuoc}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Chiều dài (mm)" Binding="{Binding ChieuDai}" Width="*" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>

                                <!-- Bolt Tab - Cường độ Column -->
                                <DataGridTemplateColumn Header="Cường độ" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CuongDo}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding CuongDo, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource DataGridComboBox}">
                                                <sys:String>CB 4.6</sys:String>
                                                <sys:String>CB 5.6</sys:String>
                                                <sys:String>CB 8.8</sys:String>
                                                <sys:String>CB 10.9</sys:String>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- SagRod Tab -->
                <TabItem Header="|| Ty Xà Gồ" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFF6F8FA" CornerRadius="4" 
                Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Filter:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="0" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding SagRodFilter, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxWithPlaceholder}" Tag="Nhập Assembly hoặc Profile..."
                         Grid.Column="1" Height="35" ToolTip="Nhập tên profile để lọc (phân cách bằng phím cách, dấu phẩy hoặc chấm phẩy)"/>

                                <TextBlock Text="Vật liệu:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="3" Margin="0,0,8,0"/>
                                <ComboBox SelectedItem="{Binding SagRodMaterial, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ModernComboBox}"
                          Grid.Column="4">
                                    <sys:String>Mạ kẽm</sys:String>
                                    <sys:String>Thép đen</sys:String>
                                </ComboBox>

                                <TextBlock Text="Ghi chú:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="6" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding SagRodNote, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxWithPlaceholder}" Tag="Nhập ghi chú..."
                                     Grid.Column="7" Height="35"/>

                                <Button Content="🔄 Tính lại" 
                                    Grid.Column="9" Height="35"
                                    Command="{Binding RecalculateSagRodCommand}"
                                    Style="{StaticResource WarningButton}"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding SagRodData}" 
                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Assembly" Binding="{Binding Assembly}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Quy cách" Binding="{Binding QuyCach}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Dài (mm)" Binding="{Binding ChieuDai}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="KL/cấu kiện" Binding="{Binding KhoiLuongMotCauKien}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="KL (kg)" Binding="{Binding KhoiLuong}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>

                                <!-- ComboBox Vật liệu - Editable -->
                                <DataGridTemplateColumn Header="Vật liệu" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VatLieu}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding VatLieu, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource DataGridComboBox}">
                                                <sys:String>Mạ kẽm</sys:String>
                                                <sys:String>Thép đen</sys:String>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" ElementStyle="{StaticResource DataGridTextBlockStyle}" EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Purlin Tab -->
                <TabItem Header="⚡ Xà Gồ" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFF6F8FA" CornerRadius="4" 
                            Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Prefix:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="0" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding PurlinFilter, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxWithPlaceholder}" Tag="Nhập Assembly hoặc Profile..."
                         Grid.Column="1" Height="35" ToolTip="Nhập tên profile để lọc (phân cách bằng phím cách, dấu phẩy hoặc chấm phẩy)"/>

                                <TextBlock Text="Cường độ:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="3" Margin="0,0,8,0"/>
                                <ComboBox SelectedItem="{Binding PurlinGrade, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ModernComboBox}"
                          Grid.Column="4">
                                    <sys:String>G275-Z80</sys:String>
                                    <sys:String>G300-Z80</sys:String>
                                    <sys:String>G350-Z80</sys:String>
                                    <sys:String>G450-Z80</sys:String>
                                    <sys:String>G550-Z80</sys:String>
                                </ComboBox>

                                <TextBlock Text="Vật liệu:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="6" Margin="0,0,8,0"/>
                                <ComboBox SelectedItem="{Binding PurlinMaterial, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ModernComboBox}"
                          Grid.Column="7">
                                    <sys:String>Mạ kẽm</sys:String>
                                    <sys:String>Thép đen</sys:String>
                                </ComboBox>

                                <TextBlock Text="Ghi chú:" VerticalAlignment="Center" 
                           FontSize="12" Grid.Column="9" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding PurlinNote, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxWithPlaceholder}" Tag="Nhập ghi chú..."
                         Grid.Column="10" Height="35"/>

                                <Button Content="🔄 Tính lại" Grid.Column="12" Height="35"
                                    Command="{Binding RecalculatePurlinCommand}"
                                    Style="{StaticResource WarningButton}"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding PurlinData}" 
                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Assembly" Binding="{Binding Assembly}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Quy cách" Binding="{Binding QuyCach}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="Dài (mm)" Binding="{Binding ChieuDai}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="KL/cấu kiện" Binding="{Binding KhoiLuongMotCauKien}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="KL (kg)" Binding="{Binding KhoiLuong}" Width="0.5*" IsReadOnly="True" ElementStyle="{StaticResource DataGridTextBlockStyle}"/>

                                <!-- ComboBox Cường độ - Editable -->
                                <DataGridTemplateColumn Header="Cường độ" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CuongDo}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding CuongDo, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DataGridComboBox}">
                                                <sys:String>G275-Z80</sys:String>
                                                <sys:String>G350-Z80</sys:String>
                                                <sys:String>G450-Z80</sys:String>
                                                <sys:String>G550-Z80</sys:String>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- ComboBox Vật liệu - Editable -->
                                <DataGridTemplateColumn Header="Vật liệu" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VatLieu}" VerticalAlignment="Center" Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding VatLieu, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DataGridComboBox}">
                                                <sys:String>Mạ kẽm</sys:String>
                                                <sys:String>Thép đen</sys:String>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" ElementStyle="{StaticResource DataGridTextBlockStyle}" EditingElementStyle="{StaticResource DataGridTextBoxStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Footer Section -->
        <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- ✅ Thêm column cho Timer -->
                </Grid.ColumnDefinitions>

                <!-- Tekla Connection Status - BÊN TRÁI -->
                <Border Grid.Column="0"  
                BorderBrush="#D1D5DB" 
                BorderThickness="0,0,1,0" 
                Padding="16,2"
                VerticalAlignment="Stretch">
                    <StackPanel Orientation="Vertical">
                        <!-- Connection Button with Dynamic Style -->
                        <Button Command="{Binding CheckTeklaConnectionCommand}"
                        Content="{Binding TeklaConnectionButtonText}"
                        ToolTip="Click để kiểm tra kết nối Tekla"
                        MinWidth="130"
                        Height="32"
                        FontSize="12"
                        FontWeight="SemiBold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTeklaConnected}" Value="True">
                                            <Setter Property="Background" Value="#FF059669"/>
                                            <Setter Property="BorderBrush" Value="#FF059669"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTeklaConnected}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Model Name -->
                        <TextBlock Text="{Binding TeklaModelName}"
                           FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="4,4,0,0"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="130"
                           ToolTip="{Binding TeklaModelName}"
                           TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Status Bar - GIỮA -->
                <StackPanel Grid.Column="1" 
                    VerticalAlignment="Center" 
                    Margin="16,8">
                    <TextBlock Text="{Binding StatusMessage}" 
                       FontSize="11"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,6"/>
                    <ProgressBar Height="6" 
                         Value="{Binding ProgressValue}" 
                         Maximum="{Binding ProgressMaximum}"
                         Background="#E5E7EB"
                         Foreground="{StaticResource PrimaryBrush}"
                         BorderThickness="0"/>
                </StackPanel>

                <!-- ✅ TIMER - GIỮA LICENSE VÀ TEKLA -->
                <Border Grid.Column="2"
                BorderBrush="#D1D5DB" 
                BorderThickness="1,0,0,0" 
                Padding="16,8"
                VerticalAlignment="Stretch">
                    <StackPanel Orientation="Vertical" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                        <!-- Timer Icon + Label -->
                        <TextBlock Text="⏱️ Thời gian" 
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontWeight="DemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,4"/>

                        <!-- Timer Display -->
                        <TextBlock Text="{Binding ElapsedTime}" 
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="Consolas"
                           TextAlignment="Center"
                           MinWidth="70">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Style.Triggers>
                                        <!-- ✅ Màu xanh khi đang chạy -->
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        </DataTrigger>
                                        <!-- ✅ Màu xanh lá khi hoàn thành -->
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="#FF059669"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- License Button - BÊN PHẢI -->
                <Border Grid.Column="3"
                BorderBrush="#D1D5DB" 
                BorderThickness="1,0,0,0" 
                Padding="16,2">
                    <StackPanel Orientation="Vertical">
                        <!-- License Button -->
                        <Button Content="🔐 Bản quyền"
                        Click="OpenLicenseWindow_Click"
                        Style="{StaticResource InfoButton}"
                        Height="32"
                        MinWidth="120"
                        ToolTip="Click để xem thông tin bản quyền"/>

                        <!-- License Status Text -->
                        <TextBlock FontSize="12"
                           Margin="0,4,0,0"
                           TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding LicenseStatusShort}"/>
                                    <Setter Property="Foreground" Value="#FF059669"/>
                                    <Setter Property="FontWeight" Value="DemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LicenseStatusShort}" Value="Vĩnh viễn">
                                            <Setter Property="Foreground" Value="#FF059669"/>
                                            <Setter Property="FontWeight" Value="DemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LicenseStatusShort}" Value="Chưa kích hoạt">
                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LicenseStatusShort}" Value="✗ Đã hết hạn">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>