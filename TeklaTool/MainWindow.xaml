<Window x:Class="TeklaTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tekla Material Takeoff Tool" 
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Logo -->
                <Image Source="/Images/tekla_logo.png" 
                       Height="Auto" Width="Auto" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" Grid.Column="0" Margin="0,0,10,0"/>
                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Tekla Material Takeoff Tool" 
                     FontSize="18" FontWeight="Bold" 
                     Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Tự động thống kê vật liệu từ mô hình Tekla Structures" 
                     FontSize="11" 
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nhóm Select -->
                    <Border BorderBrush="#D1D5DB" BorderThickness="0,0,1,0" Margin="0,0,10,0" Padding="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔍 Chọn Parts" 
                                Command="{Binding SelectPartsCommand}" Height="35"
                                Style="{StaticResource ModernButton}" Margin="0,0,20,0"/>
                            <Button Content="📦 Chọn Model" Height="35"
                                Command="{Binding SelectAllModelCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- Nhóm Excel -->
                    <Border BorderBrush="#D1D5DB" BorderThickness="0,0,0,0" Margin="0,0,10,0" Padding="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📊 Xuất Excel" Height="35"
                                Command="{Binding ExportExcelCommand}"
                                Style="{StaticResource SuccessButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results Section with TabControl -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" 
                                          Background="Transparent"
                                          BorderThickness="0,0,0,2"
                                          BorderBrush="Transparent"
                                          Padding="12,6"
                                          Margin="0,0,4,0">
                                        <ContentPresenter ContentSource="Header" 
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" 
                                                  Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" 
                                                  Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" 
                                                  Value="#F9FAFB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </TabControl.Resources>

                <!-- Plate Tab -->
                <TabItem Header="🔲 Thép Tấm" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Compact Config -->
                        <Border Grid.Row="0" Background="#FFF6F8FA" CornerRadius="4" 
                                Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chiều rộng (mm):" VerticalAlignment="Center" 
                                         FontSize="12" Grid.Column="0" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding PlateWidth, UpdateSourceTrigger=PropertyChanged}" 
                                       Style="{StaticResource ModernTextBox}" Grid.Column="1"/>
                                <TextBlock Text="Chiều dài (mm):" VerticalAlignment="Center" 
                                         FontSize="12" Grid.Column="3" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding PlateLength, UpdateSourceTrigger=PropertyChanged}" 
                                       Style="{StaticResource ModernTextBox}" Grid.Column="4"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding PlateData}" 
                                Style="{StaticResource ModernDataGrid}"
                                CellEditEnding="OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Dày (mm)" Binding="{Binding ChieuDay}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Rộng (mm)" Binding="{Binding ChieuRong}" Width="90"/>
                                <DataGridTextColumn Header="Dài (mm)" Binding="{Binding ChieuDai}" Width="90"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="KL (kg)" Binding="{Binding KhoiLuong, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Vật liệu" Binding="{Binding VatLieu}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Shape Tab -->
                <TabItem Header="📏 Thép Hình" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Compact Config -->
                        <Border Grid.Row="0" Background="#FFF6F8FA" CornerRadius="4" 
                                Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chiều dài chuẩn (mm):" VerticalAlignment="Center" 
                                         FontSize="12" Grid.Column="0" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding ShapeLength, UpdateSourceTrigger=PropertyChanged}" 
                                       Style="{StaticResource ModernTextBox}" Grid.Column="1"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ShapeData}" 
                                Style="{StaticResource ModernDataGrid}"
                                CellEditEnding="OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Quy cách" Binding="{Binding QuyCach}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Dài (mm)" Binding="{Binding ChieuDai}" Width="90"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="KL/m (kg)" Binding="{Binding KhoiLuongDonVi, StringFormat=N3}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="KL (kg)" Binding="{Binding KhoiLuong, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Vật liệu" Binding="{Binding VatLieu}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Bolt Tab -->
                <TabItem Header="🔩 Bulong" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Compact Config -->
                        <Border Grid.Row="0" Background="#FFF6F8FA" CornerRadius="4" 
                                Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cường độ:" VerticalAlignment="Center" 
                                         FontSize="12" Grid.Column="0" Margin="0,0,8,0"/>
                                <ComboBox SelectedItem="{Binding BoltGrade}"
                                        Style="{StaticResource ModernComboBox}"
                                        Grid.Column="1">
                                    <ComboBoxItem Content="4.6"/>
                                    <ComboBoxItem Content="5.6"/>
                                    <ComboBoxItem Content="8.8" IsSelected="True"/>
                                    <ComboBoxItem Content="10.9"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding BoltData}" 
                                Style="{StaticResource ModernDataGrid}"
                                CellEditEnding="OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Kích thước" Binding="{Binding KichThuoc}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Cường độ" Binding="{Binding CuongDo}" Width="100"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Purlin Tab -->
                <TabItem Header="⚡ Xà Gồ" FontWeight="SemiBold">
                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding PurlinData}" 
                            Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Assembly" Binding="{Binding Assembly}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Quy cách" Binding="{Binding QuyCach}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding SoLuong, StringFormat=N2}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Dài (mm)" Binding="{Binding ChieuDai, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="KL/cấu kiện" Binding="{Binding KhoiLuongMotCauKien, StringFormat=N3}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="KL (kg)" Binding="{Binding KhoiLuong, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Vật liệu" Binding="{Binding VatLieu}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Footer Section -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Bar -->
                <StackPanel VerticalAlignment="Center" Margin="16,6" Grid.Column="0">
                    <TextBlock Text="{Binding StatusMessage}" 
                             FontSize="11"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Margin="0,0,0,7"/>
                    <ProgressBar Height="6" 
                               Value="{Binding ProgressValue}" 
                               Maximum="{Binding ProgressMaximum}"
                               Background="#E5E7EB"
                               Foreground="{StaticResource PrimaryBrush}"
                               BorderThickness="0"/>
                </StackPanel>

                <Border BorderBrush="#D1D5DB" BorderThickness="1,0,0,0" 
                        Margin="10,0,0,0" Padding="0,0,10,0" Grid.Column="1">
                    <Button Content="🔐 Bản quyền"
                        Click="OpenLicenseWindow_Click"
                        Style="{StaticResource SuccessButton}" 
                        Margin="10,0,0,0"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>