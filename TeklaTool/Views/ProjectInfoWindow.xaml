<Window x:Class="TeklaTool_2017.Views.ProjectInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TeklaTool_2017.Helpers"
        Title="Thông tin dự án" 
        MinWidth="600" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    
    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    
    <Border Margin="16" Padding="24" 
            Background="White" 
            CornerRadius="8" 
            BorderBrush="#E5E7EB" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.08" 
                            BlurRadius="12" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="📋" FontSize="20" Margin="0,0,8,0"/>
                <TextBlock Text="Thông tin dự án" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="#2563EB"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Nhập thông tin để xuất kèm file Excel" 
                       FontSize="12" 
                       Foreground="#6B7280"
                       Margin="0,0,0,20"/>

            <!-- Project Name -->
            <TextBlock Text="Tên công trình:" 
                       FontSize="12" 
                       FontWeight="Medium"
                       Foreground="#374151"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBoxWithPlaceholder}" Tag="Nhập tên công trình..."
                     Margin="0,0,0,16"
                     Height="35"/>

            <!-- Designer -->
            <TextBlock Text="Người thiết kế:" 
                       FontSize="12" 
                       FontWeight="Medium"
                       Foreground="#374151"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding Designer, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBoxWithPlaceholder}" Tag="Nhập tên người thiết kế..."
                     Margin="0,0,0,16"
                     Height="35"/>

            <!-- Factory Address (NEW) -->
            <TextBlock Text="Địa chỉ nhà máy:" 
                       FontSize="12" 
                       FontWeight="Medium"
                       Foreground="#374151"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding FactoryAddress, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBoxWithPlaceholder}" Tag="Nhập địa chỉ nhà máy..."
                     Margin="0,0,0,16"
                     Height="35"
                     />

            <!-- Delivery Location -->
            <TextBlock Text="Địa điểm giao hàng:" 
                       FontSize="12" 
                       FontWeight="Medium"
                       Foreground="#374151"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding DeliveryLocation, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBoxWithPlaceholder}" Tag="Nhập địa điểm giao hàng..."
                     Margin="0,0,0,16"
                     Height="35"/>

            <!-- Delivery Schedule -->
            <TextBlock Text="Tiến độ cấp hàng:" 
                       FontSize="12" 
                       FontWeight="Medium"
                       Foreground="#374151"
                       Margin="0,0,0,6"/>
            <DatePicker SelectedDate="{Binding DeliveryScheduleDate}" 
                        Height="35" 
                        Margin="0,0,0,16"
                        VerticalContentAlignment="Center"
                        Style="{StaticResource ModernDatePicker}"/>

            <!-- Logo Section -->
            <TextBlock Text="Logo công ty (tùy chọn):" 
                       FontSize="12" 
                       FontWeight="Medium"
                       Foreground="#374151"
                       Margin="0,0,0,6"/>

            <Border BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6"
                    Background="#F9FAFB"
                    Padding="12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="60" Height="60" 
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,12,0">
                            <Image Source="{Binding LogoPreview}"
                                   MaxWidth="200"
                                   MaxHeight="100"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LogoFileName" 
                                       Text="Chưa chọn file"
                                       FontSize="11"
                                       Foreground="#374151"
                                       FontWeight="Medium"/>
                            <TextBlock Text="PNG, JPG, JPEG (tối đa 5MB)" 
                                       FontSize="10"
                                       Foreground="#9CA3AF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Content="📁 Chọn file"
                            Click="BrowseLogo_Click"
                            Height="36"
                            Padding="16,8"
                            FontSize="12"
                            Style="{StaticResource SecondaryButton}"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Sheet Selection (NEW) -->
            <TextBlock Text="Chọn sheet xuất Excel:" 
                       FontSize="12" 
                       FontWeight="Medium"
                       Foreground="#374151"
                       Margin="0,0,0,8"/>

            <Border BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6"
                    Background="#F9FAFB"
                    Padding="12"
                    Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox Content="✓ Tất cả sheet" 
                              IsChecked="{Binding ExportAllSheets}"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8"
                              Style="{StaticResource ModernCheckBox}"/>

                    <StackPanel Margin="20,0,0,0" IsEnabled="{Binding ExportAllSheets, Converter={StaticResource InverseBoolConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Thép tấm" Grid.Column="0" IsChecked="{Binding ExportPlate}" FontSize="11" Margin="0,4,0,0" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox Content="Thép hình" Grid.Column="1" IsChecked="{Binding ExportShape}" FontSize="11" Margin="0,4,0,0" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox Content="Bulong" Grid.Column="2" IsChecked="{Binding ExportBolt}" FontSize="11" Margin="0,4,0,0" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox Content="Ty xà gồ" Grid.Column="3" IsChecked="{Binding ExportSagRod}" FontSize="11" Margin="0,4,0,0" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox Content="Xà gồ" Grid.Column="4" IsChecked="{Binding ExportPurlin}" FontSize="11" Margin="0,4,0,0" Style="{StaticResource ModernCheckBox}"/>
                        </Grid>
                        
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Separator -->
            <Border Height="1" 
                    Background="{StaticResource BorderBrush}" 
                    Margin="0,0,0,20"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="❌ Hủy" 
                        Width="100" 
                        Height="36" 
                        Margin="0,0,12,0"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}"
                        Cursor="Hand"/>

                <Button Content="✓ Lưu và Xuất Excel" 
                        Width="Auto" 
                        Height="36"
                        Click="Save_Click"
                        Style="{StaticResource SuccessButton}"
                        Cursor="Hand"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>